prefix=C:/Users/task_177429916378933/croot/curl-split_1774299432862/_h_env/Library
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE FTP FTPS GOPHER GOPHERS HTTP HTTPS IMAP IMAPS IPFS IPNS MQTT MQTTS POP3 POP3S RTSP SCP SFTP SMB SMBS SMTP SMTPS TELNET TFTP WS WSS"
supported_features="alt-svc AsynchDNS brotli HSTS HTTPS-proxy IPv6 Kerberos Largefile libz NTLM SPNEGO SSL SSPI threadsafe Unicode UnixSockets zstd"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
Version: 8.19.0
Requires: 
Requires.private: libssh2,zlib,libbrotlidec,libbrotlicommon,libzstd
Libs: -L${libdir} -lcurl 
Libs.private:  -lssh2 C:/Users/task_177429916378933/croot/curl-split_1774299432862/_h_env/Library/lib/z.lib C:/Users/task_177429916378933/croot/curl-split_1774299432862/_h_env/Library/lib/brotlidec.lib C:/Users/task_177429916378933/croot/curl-split_1774299432862/_h_env/Library/lib/brotlicommon.lib C:/Users/task_177429916378933/croot/curl-split_1774299432862/_h_env/Library/lib/zstd.lib -lbcrypt -ladvapi32 -lcrypt32 -lsecur32 -lws2_32 -liphlpapi
Cflags: -I${includedir} 
Cflags.private: -DCURL_STATICLIB
